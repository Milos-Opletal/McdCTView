# McDonald's API Credentials (Manager role required for restaurant floorplans)
# MYMCD_EMAIL and MYMCD_PASSWORD are the standard names across all services.
# Legacy MCD_EMAIL and MCD_PASSWORD are also supported for Portainer compatibility.
MYMCD_EMAIL=your_email@example.com
MYMCD_PASSWORD=your_password_here

# Flask Session Security (Optional, auto-generated if omitted)
FLASK_SECRET_KEY=generate_a_random_secret_key_here
